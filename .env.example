# Backend
CORS_ORIGINS=http://localhost:3000
AIRCRAFT_PROVIDERS=adsblol,adsbfi,airplaneslive,opensky

# Built-in free providers
AIRPLANESLIVE_BASE_URL=https://api.airplanes.live/v2
AIRPLANESLIVE_TIMEOUT_SECONDS=12
AIRPLANESLIVE_REFRESH_SECONDS=180

ADSBFI_BASE_URL=https://opendata.adsb.fi/api
ADSBFI_TIMEOUT_SECONDS=12
ADSBFI_REFRESH_SECONDS=10

ADSBLOL_BASE_URL=https://api.adsb.lol
ADSBLOL_TIMEOUT_SECONDS=12
ADSBLOL_REFRESH_SECONDS=10

# Optional OpenSky OAuth
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_TIMEOUT_SECONDS=12
OPENSKY_REFRESH_SECONDS=240

# Optional paid-provider credentials
# Reserved for the corresponding provider adapters; the default build does not
# consume these values until that adapter is implemented/enabled.
ADSBX_API_KEY=
FR24_API_TOKEN=

# Fusion / geospatial behavior
CACHE_TTL_SECONDS=4
OVERHEAD_THRESHOLD_KM=8

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_POLL_INTERVAL_MS=10000
